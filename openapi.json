{
  "openapi": "3.0.3",
  "info": {
    "title": "Lumia Agent Camera",
    "version": "0.4.0",
    "description": "Asynchronous preview and full-resolution still capture through a Raspberry Pi bridge. Coordinates use unrotated encoded JPEG pixels. Phone app must be foregrounded. Manual workflow: authorize with agent_token, submit a camera job, poll its id, then retrieve image.url or crop the retained original. Keep Lumia Agent open; use the explorer from another device."
  },
  "servers": [
    {
      "url": "/",
      "description": "This bridge (same origin as the API explorer)"
    }
  ],
  "security": [
    {
      "agentToken": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is running"
          }
        },
        "tags": [
          "Service"
        ]
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "description": "Phone connectivity, model, job state, and retained image count"
          }
        },
        "tags": [
          "Service"
        ]
      }
    },
    "/v1/preview": {
      "post": {
        "operationId": "takePreview",
        "description": "Queue a viewfinder snapshot. Poll the returned job. Not a full-resolution still.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraRequest"
              },
              "examples": {
                "baseline": {
                  "summary": "Baseline camera settings",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": false,
                    "focus_range": "auto",
                    "controls": {}
                  }
                },
                "focusRegion": {
                  "summary": "Verified normal-range autofocus, central region",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": true,
                    "focus_range": "normal",
                    "focus_region": {
                      "x": 0.25,
                      "y": 0.25,
                      "width": 0.5,
                      "height": 0.5
                    }
                  }
                },
                "manualLens": {
                  "summary": "Manual lens position (device units)",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": false,
                    "controls": {
                      "manual_focus_position": 500
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Job"
          },
          "503": {
            "description": "No phone connected"
          },
          "429": {
            "description": "Queue is full"
          },
          "409": {
            "description": "Phone app must be updated to support explicit focus ranges"
          },
          "400": {
            "description": "Invalid camera controls, focus region, or unsupported sensor setting"
          }
        },
        "tags": [
          "Camera"
        ]
      }
    },
    "/v1/captures": {
      "post": {
        "operationId": "captureFullResolution",
        "description": "Rear requests documented 1020 38 MP 4:3 or 34 MP 16:9 mode. Front uses actual maximum resolution. Rear images below 30 MP fail explicitly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraRequest"
              },
              "examples": {
                "baseline": {
                  "summary": "Baseline camera settings",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": true,
                    "focus_range": "auto",
                    "controls": {}
                  }
                },
                "focusRegion": {
                  "summary": "Verified normal-range autofocus, central region",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": true,
                    "focus_range": "normal",
                    "focus_region": {
                      "x": 0.25,
                      "y": 0.25,
                      "width": 0.5,
                      "height": 0.5
                    }
                  }
                },
                "manualLens": {
                  "summary": "Manual lens position (device units)",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": false,
                    "controls": {
                      "manual_focus_position": 500
                    }
                  }
                },
                "manualExposure": {
                  "summary": "Manual ISO and approximately 1/60 second shutter",
                  "value": {
                    "camera": "rear",
                    "aspect": "4:3",
                    "focus": true,
                    "focus_range": "normal",
                    "controls": {
                      "iso": 3200,
                      "exposure_time_us": 16667,
                      "flash_mode": 0
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Job"
          },
          "503": {
            "description": "No phone connected"
          },
          "429": {
            "description": "Queue is full"
          },
          "409": {
            "description": "Phone app must be updated to support explicit focus ranges"
          },
          "400": {
            "description": "Invalid camera controls, focus region, or unsupported sensor setting"
          }
        },
        "tags": [
          "Camera"
        ]
      }
    },
    "/v1/jobs/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "getJob",
        "description": "Poll until done/error. Jobs expire after 180 seconds; records retained up to one hour.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Job"
          },
          "404": {
            "description": "Unknown or no longer retained job"
          }
        },
        "tags": [
          "Jobs"
        ]
      }
    },
    "/v1/images/{id}.jpg": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "downloadImage",
        "responses": {
          "200": {
            "description": "JPEG bytes (capture originals are preserved byte for byte)",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown image"
          }
        },
        "tags": [
          "Images"
        ]
      }
    },
    "/v1/images/{id}/thumbnail.jpg": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "get": {
        "operationId": "thumbnail",
        "parameters": [
          {
            "name": "max",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 64,
              "maximum": 4096,
              "default": 1280
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JPEG thumbnail, same raster orientation as original",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "tags": [
          "Images"
        ]
      }
    },
    "/v1/images/{id}/crop": {
      "parameters": [
        {
          "$ref": "#/components/parameters/id"
        }
      ],
      "post": {
        "operationId": "cropImage",
        "description": "Crop an existing image; no new camera exposure. Integer source JPEG pixels, top-left origin. JPEG quality 95, no resize/rotation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Crop metadata and download URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Image"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/out-of-bounds crop"
          }
        },
        "tags": [
          "Images"
        ]
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCameraCapabilities",
        "tags": [
          "Controls"
        ],
        "description": "Live per-sensor control choices, ranges and focus-region support reported by Lumia Agent 0.1.9+. ready=false until the phone has registered and reported. Reload /docs after capabilities arrive to see the dynamic control schema.",
        "responses": {
          "200": {
            "description": "Camera capability report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ready": {
                      "type": "boolean"
                    },
                    "connected": {
                      "type": "boolean"
                    },
                    "cameras": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "agent_token from bridge config; never use device_token for these routes"
      }
    },
    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    "responses": {
      "Job": {
        "description": "Job metadata; image appears on successful completion",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Job"
            }
          }
        }
      }
    },
    "schemas": {
      "CameraRequest": {
        "type": "object",
        "properties": {
          "camera": {
            "type": "string",
            "enum": [
              "rear",
              "front"
            ],
            "default": "rear"
          },
          "aspect": {
            "type": "string",
            "enum": [
              "4:3",
              "16:9",
              "maximum"
            ],
            "default": "4:3"
          },
          "focus": {
            "type": "boolean",
            "description": "Default true for captures, false for previews. When true, reset stale focus, scan and verify a lock (up to two attempts); a failed lock returns a job error. Fixed-focus cameras report unsupported."
          },
          "focus_range": {
            "type": "string",
            "enum": [
              "auto",
              "normal",
              "macro",
              "full",
              "infinity",
              "hyperfocal"
            ],
            "default": "auto",
            "description": "Explicit ranges require focus=true, the rear camera and Lumia Agent 0.1.8+. The phone must support the requested range. normal excludes close macro subjects; macro is for close subjects; full scans the full supported range. auto chooses normal, then full, then device default. Returned image metadata lists supported ranges."
          },
          "controls": {
            "type": "object",
            "description": "Phone-supported native settings. GET /v1/capabilities for actual names, types, ranges and units. The live /openapi.json fills this schema from the current phone. Overrides are per request and restored after acquisition. ISO/exposure/WB accept null for auto where advertised. Manual focus requires focus=false.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "integer",
                  "nullable": true
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "example": {}
          },
          "focus_region": {
            "type": "object",
            "nullable": true,
            "description": "Normalized region of the unrotated sensor preview. Requires focus=true and reported focus-region support. Not full-resolution crop pixels.",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "preview",
              "capture"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "done",
              "error"
            ]
          },
          "error": {
            "type": "string"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          },
          "focus_range": {
            "type": "string",
            "enum": [
              "auto",
              "normal",
              "macro",
              "full",
              "infinity",
              "hyperfocal"
            ]
          },
          "controls": {
            "type": "object",
            "description": "Phone-supported native settings. GET /v1/capabilities for actual names, types, ranges and units. The live /openapi.json fills this schema from the current phone. Overrides are per request and restored after acquisition. ISO/exposure/WB accept null for auto where advertised. Manual focus requires focus=false.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "integer",
                  "nullable": true
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "example": {}
          },
          "focus_region": {
            "type": "object",
            "nullable": true,
            "description": "Normalized region of the unrotated sensor preview. Requires focus=true and reported focus-region support. Not full-resolution crop pixels.",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "Image": {
        "type": "object",
        "required": [
          "id",
          "width",
          "height",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "exif_orientation": {
            "type": "integer"
          },
          "coordinates": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "focus_status": {
            "type": "string",
            "enum": [
              "locked",
              "manual",
              "skipped",
              "unsupported"
            ],
            "description": "Reported by phone 0.1.8+. A lock is a device autofocus result, not an optical sharpness guarantee."
          },
          "focus_attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "focus_range": {
            "type": "string",
            "description": "Applied range, or device_default/unchanged/fixed/manual."
          },
          "supported_focus_ranges": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "normal",
                "macro",
                "full",
                "infinity",
                "hyperfocal"
              ]
            }
          },
          "applied_controls": {
            "type": "object",
            "description": "Actual native values read back after application. Present on new phone versions.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "integer",
                  "nullable": true
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "focus_region": {
            "type": "object",
            "nullable": true,
            "description": "Normalized region of the unrotated sensor preview. Requires focus=true and reported focus-region support. Not full-resolution crop pixels.",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "iso": {
            "type": "integer",
            "description": "Actual capture ISO from JPEG EXIF, when present."
          },
          "exposure_seconds": {
            "type": "number",
            "description": "Actual shutter exposure from JPEG EXIF, when present."
          }
        }
      }
    }
  }
}
